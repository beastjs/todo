import { Outlet, useLocation } from "@octanejs/tanstack-router";
import ActionTabs from "./ActionTabs.btsx";
import type { TabItem } from "@/components/ui/Tabs.btsx";

module
  const items: TabItem[] = [{id: 'text', label: 'Text', shortLabel: 'Text', href: '/text', icon: 'arrow-right'}, {id: 'voice', label: 'Voice', shortLabel: 'Voice', href: '/voice', icon: 'arrow-right'}]

setup
  const path = useLocation({ select: location => location.pathname })
  const activeId = items.find(tab => tab.href !== '/' && path.replace(/\/$/, '') === tab.href)?.id ?? ''

div(className='h-160 grid grid-cols-7')
  div(className='col-span-2 bg-foreground/1 h-full p-6 border-r border-[#666] dark:border-[#333] border-dotted rounded-[2.5rem] bg-foreground/4')
    h2(className='uppercase text-xs font-mono tracking-widest p-2 opacity-70 border-b border-dotted') Actions
    div(className='size-full')
      ActionTabs(items={items} activeId={activeId})
  div(className='col-span-5')
    Outlet
