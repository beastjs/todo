import GlowCursor from "@/components/bits/GlowCursor.btsx";
import Stack from "@/components/bits/Stack.btsx";
module
  const images = [
    "https://images.unsplash.com/photo-1480074568708-e7b720bb3f09?q=80&w=500&auto=format",
    "https://images.unsplash.com/photo-1449844908441-8829872d2607?q=80&w=500&auto=format",
    "https://images.unsplash.com/photo-1452626212852-811d58933cae?q=80&w=500&auto=format",
    "https://images.unsplash.com/photo-1572120360610-d971b9d7767c?q=80&w=500&auto=format"
    ];

div(className='flex items-center justify-center bg-transparent')
  div(style={{ width: 360, height: 430, backgroundColor: 'transparent' }})
    Stack(
      ~ layout="fan"
      ~ sendToBackOnClick={false}
      ~ cards={images.map((src, i) => <img key={src} src={src} alt={`Card ${i + 1}`}/>) }
      ~ visible={4}
      ~ spread={0.5}
      ~ depth={0.5}
      ~ radius={16}
      ~ frame={0}
      ~ frameColor="#ffffff"
      ~ shadow
      ~ tilt={30}
      ~ threshold={90}
      ~ speed={1}
      ~ autoplay={false}
      ~ autoplayDelay={3000}
      ~ pauseOnHover={false}
      ~ )
